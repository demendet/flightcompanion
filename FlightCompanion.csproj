<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>Core\app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- The rules and their tests are separate projects: keep them out of this one's wildcard. -->
  <ItemGroup>
    <Compile Remove="Game\**" />
    <Compile Remove="Tests\**" />
    <AvaloniaXaml Remove="Game\**;Tests\**" />
    <EmbeddedResource Remove="Game\**;Tests\**" />
    <None Remove="Game\**;Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Game\FlightCompanion.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.0" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.0" />

    <!-- Claude plays the people and takes the notes. -->
    <PackageReference Include="Anthropic" Version="13.6.0" />

    <!-- Microphone and speakers. -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- Detects speech properly instead of a loudness threshold. -->
    <PackageReference Include="SileroVad" Version="2.1.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />

    <!-- Local speech to text, on the GPU through Vulkan. -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.8.1" />

    <!-- Protected storage for API keys. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>lib\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="lib\SimConnect.dll;lib\Ijwhost.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <AvaloniaResource Include="Assets\*" />
  </ItemGroup>
</Project>
