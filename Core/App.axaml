<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlightCompanion.App"
             RequestedThemeVariant="Dark">

    <!-- The colours of the polar night over the vidda, with survival yellow as the one thing that shouts. -->
    <Application.Resources>
        <SolidColorBrush x:Key="Night" Color="#10201F" />
        <SolidColorBrush x:Key="Panel" Color="#172B29" />
        <SolidColorBrush x:Key="Raised" Color="#1F3A36" />
        <SolidColorBrush x:Key="Line" Color="#2B4542" />
        <SolidColorBrush x:Key="Snow" Color="#E6EEE9" />
        <SolidColorBrush x:Key="Lichen" Color="#8FA8A0" />
        <SolidColorBrush x:Key="Signal" Color="#F4C430" />
        <SolidColorBrush x:Key="SignalInk" Color="#1A1605" />
        <SolidColorBrush x:Key="Danger" Color="#EE6A5E" />
        <SolidColorBrush x:Key="Okay" Color="#7FCB8F" />
        <FontFamily x:Key="Din">Bahnschrift, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource Din}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Snow}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.quiet">
            <Setter Property="Foreground" Value="{StaticResource Lichen}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.head">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Lichen}" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.big">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="Foreground" Value="{StaticResource Snow}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Line}" />
            <Setter Property="Foreground" Value="{StaticResource Snow}" />
        </Style>
        <Style Selector="Button.go">
            <Setter Property="Background" Value="{StaticResource Signal}" />
            <Setter Property="Foreground" Value="{StaticResource SignalInk}" />
            <Setter Property="BorderBrush" Value="{StaticResource Signal}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.go:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFD75A" />
            <Setter Property="Foreground" Value="{StaticResource SignalInk}" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Lichen}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.person">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource Night}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource Snow}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Signal}" />
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Application.Styles>
</Application>
