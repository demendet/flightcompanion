<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rules of the game. No sim, audio or UI references, so everything here can be tested without flying. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlightCompanion.Game</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
