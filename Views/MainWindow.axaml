<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FlightCompanion.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="FlightCompanion.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Flight Companion — Finnmark Bush Ops"
        Background="{StaticResource AppBg}"
        WindowState="Maximized">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- ==================== Header bar ==================== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}"
                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1"
                Padding="24,0" Height="64"
                BoxShadow="0 2 18 0 #40000000">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentGradient}"
                            VerticalAlignment="Center">
                        <TextBlock Text="✈" FontSize="20" Foreground="#FF06222B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FLIGHT COMPANION" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" LetterSpacing="1" />
                        <TextBlock Text="Finnmark Bush Charter · MSFS 2024" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Status readouts -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceInput}" CornerRadius="20" Padding="12,6"
                            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource SuccessGreen}" IsVisible="{Binding IsConnected}" />
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="#FF5A6678" IsVisible="{Binding !IsConnected}" />
                            <TextBlock Text="MSFS" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceInput}" CornerRadius="20" Padding="12,6"
                            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{StaticResource SuccessGreen}" IsVisible="{Binding IsSignalRConnected}" />
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="#FF5A6678" IsVisible="{Binding !IsSignalRConnected}" />
                            <TextBlock Text="MULTIPLAYER" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Body ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="340,*,380">

            <!-- Left: Ops -->
            <ScrollViewer Grid.Column="0" Padding="16">
                <StackPanel Spacing="14">

                    <!-- Testing -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="overline" Text="TESTING" />
                            <Button Content="📞  Simulate Incoming Call" Classes="accent"
                                    Command="{Binding TestCallCommand}" HorizontalAlignment="Stretch" />
                            <TextBlock Classes="muted" Text="Triggers a caller instantly instead of waiting for the timer."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- MSFS Connection -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="overline" Text="MSFS CONNECTION" />
                            <Button Content="{Binding ConnectButtonText}" Classes="accent"
                                    Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding ConnectionStatus}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Multiplayer -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="overline" Text="MULTIPLAYER" />
                            <TextBox Text="{Binding PlayerName}" Watermark="Your pilot name" />
                            <Button Content="{Binding MultiplayerButtonText}" Classes="ghost"
                                    Command="{Binding ConnectMultiplayerCommand}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding MultiplayerStatus}" Classes="muted" TextWrapping="Wrap" />
                            <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,2" />
                            <Button Content="Create New Session" Classes="success"
                                    Command="{Binding CreateSessionCommand}" HorizontalAlignment="Stretch" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SessionId}" Watermark="Session ID" />
                                <Button Grid.Column="1" Content="Join" Classes="ghost"
                                        Command="{Binding JoinSessionCommand}" Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Aircraft data -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="overline" Text="AIRCRAFT TELEMETRY" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" >
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Classes="muted" Text="LATITUDE" FontSize="10" />
                                    <TextBlock Text="{Binding FormattedLatitude}" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Classes="muted" Text="LONGITUDE" FontSize="10" />
                                    <TextBlock Text="{Binding FormattedLongitude}" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Classes="muted" Text="ALTITUDE" FontSize="10" />
                                    <TextBlock Text="{Binding FormattedAltitude}" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Classes="muted" Text="GROUND SPEED" FontSize="10" />
                                    <TextBlock Text="{Binding FormattedSpeed}" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Classes="muted" Text="HEADING" FontSize="10" />
                                    <TextBlock Text="{Binding FormattedHeading}" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="13" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Center: Map -->
            <Border Grid.Column="1" Classes="card" Margin="0,16" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,12">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="overline" Text="LIVE MAP" />
                            <TextBlock Text="Finnmarksvidda · pickup routes" Classes="muted" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceInput}" CornerRadius="20"
                                Padding="10,5" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="3" Background="{StaticResource Accent}" VerticalAlignment="Center" CornerRadius="2" />
                                <TextBlock Text="Active route" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" CornerRadius="0,0,12,12" ClipToBounds="True">
                        <ContentControl Name="MapContainer" />
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Phone + Trips -->
            <ScrollViewer Grid.Column="2" Padding="16">
                <StackPanel Spacing="14">

                    <!-- Proximity payload prompt -->
                    <Border Classes="card" IsVisible="{Binding HasPayloadPrompt}"
                            Background="#FF13233A" BorderBrush="{StaticResource Accent}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding PayloadPromptTitle}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" />
                            <TextBlock Text="{Binding PayloadPromptDetail}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="You're stopped at the pickup — load them aboard?" Classes="muted"
                                       FontSize="11" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" >
                                <Button Grid.Column="0" Content="⬆  Load into aircraft" Classes="accent"
                                        Command="{Binding LoadPayloadCommand}" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="Later" Classes="ghost"
                                        Command="{Binding DismissPayloadCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Payload status toast -->
                    <Border Classes="card" IsVisible="{Binding HasPayloadStatus}"
                            Background="#FF10241A" BorderBrush="{StaticResource SuccessGreen}" Padding="12">
                        <TextBlock Text="{Binding PayloadStatus}" Foreground="#FFB6F0C9" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <!-- Phone -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="overline" Text="PHONE" />

                            <!-- Incoming -->
                            <Border CornerRadius="10" Padding="14" IsVisible="{Binding IsCallIncoming}"
                                    Background="#FF2A2410" BorderBrush="{StaticResource WarningOrange}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="📞  Incoming call" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource WarningOrange}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentCall.CallerName}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                    <Grid ColumnDefinitions="*,*" >
                                        <Button Grid.Column="0" Content="Answer" Classes="success" Margin="0,0,4,0"
                                                Command="{Binding AnswerCallCommand}" CommandParameter="{Binding CurrentCall}"
                                                HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="Reject" Classes="danger" Margin="4,0,0,0"
                                                Command="{Binding RejectCallCommand}" CommandParameter="{Binding CurrentCall}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Active call -->
                            <Border CornerRadius="10" Padding="14" IsVisible="{Binding HasActiveCall}"
                                    Background="#FF10241A" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessGreen}" VerticalAlignment="Center" />
                                        <TextBlock Text="In call" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessGreen}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentCall.CallerName}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />

                                    <!-- Mic meter -->
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="🎙  Listening…" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                        <ProgressBar Value="{Binding AudioLevelPercent}" Maximum="100" Height="6"
                                                     CornerRadius="3" Background="{StaticResource SurfaceInput}"
                                                     Foreground="{StaticResource Accent}" />
                                    </StackPanel>

                                    <!-- Conversation -->
                                    <Border Background="{StaticResource SurfaceInput}" CornerRadius="8" Padding="10" MaxHeight="240">
                                        <ScrollViewer Name="ConversationScrollViewer" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ConversationHistory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="2" Margin="0,4">
                                                            <TextBlock Text="{Binding Speaker}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding SpeakerColor}" />
                                                            <TextBlock Text="{Binding Message}" FontSize="12"
                                                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Live transcription -->
                                    <Border Background="#FF102030" CornerRadius="8" Padding="10"
                                            BorderBrush="{StaticResource AccentDim}" BorderThickness="1"
                                            IsVisible="{Binding LiveTranscript, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="🎤 YOU (LIVE)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="{Binding LiveTranscript}" FontSize="13"
                                                       Foreground="#FFB8E8F5" TextWrapping="Wrap" FontStyle="Italic" />
                                        </StackPanel>
                                    </Border>

                                    <Button Content="End call" Classes="danger" HorizontalAlignment="Stretch"
                                            Command="{Binding EndCallCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Recent calls -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Recent" Classes="muted" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding CallHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding CallerName}" Foreground="{StaticResource TextPrimary}"
                                                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}"
                                                               Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Flight plans / trip cards -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="overline" Text="TRIPS" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource SurfaceInput}" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="{Binding TripCountLabel}" Classes="muted" FontSize="11" />
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding FlightPlans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="14" Margin="0,4"
                                                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <!-- header row -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding CustomerName}" Foreground="{StaticResource TextPrimary}"
                                                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="{StaticResource AccentDim}" CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextPrimary}" FontSize="10" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                                <!-- route -->
                                                <Grid ColumnDefinitions="*,Auto,*">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="PICKUP" FontSize="9" Foreground="{StaticResource TextMuted}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Origin}" Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource Accent}" FontSize="18"
                                                               FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="DROP-OFF" FontSize="9" Foreground="{StaticResource TextMuted}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Destination}" Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- chips -->
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Background="{StaticResource SurfaceInput}" CornerRadius="6" Padding="8,4">
                                                        <TextBlock Text="{Binding PassengerCount, StringFormat='👤 {0} pax'}" Foreground="{StaticResource TextPrimary}" FontSize="11" />
                                                    </Border>
                                                    <Border Background="{StaticResource SurfaceInput}" CornerRadius="6" Padding="8,4">
                                                        <TextBlock Text="{Binding BaggageWeight, StringFormat='🧳 {0:F0} kg'}" Foreground="{StaticResource TextPrimary}" FontSize="11" />
                                                    </Border>
                                                    <Border Background="#FF16301F" CornerRadius="6" Padding="8,4">
                                                        <TextBlock Text="{Binding AgreedPrice, StringFormat='{}{0:F0} kr'}" Foreground="#FF7BE8A5" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No trips yet — answer a call to book one."
                                       Classes="muted" FontSize="11" HorizontalAlignment="Center"
                                       IsVisible="{Binding HasNoTrips}" Margin="0,8" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
