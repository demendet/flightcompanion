<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlightCompanion.ViewModels"
        xmlns:v="using:FlightCompanion.Views"
        x:Class="FlightCompanion.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Flight Companion"
        Width="1440" Height="900" MinWidth="1120" MinHeight="680"
        Background="{StaticResource Night}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Who you are and how the business is doing -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="26" VerticalAlignment="Center">
                    <TextBlock Classes="big" Text="{Binding Pic.Company}" />
                    <TextBlock Classes="big" Text="{Binding Pic.Cash}" Foreground="{Binding Pic.CashBrush}" />
                    <StackPanel Width="210" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Classes="quiet" Text="{Binding Pic.Rank}" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Pic.Reputation}" Height="4" MinWidth="0" />
                    </StackPanel>
                    <TextBlock Classes="quiet" VerticalAlignment="Center" Text="{Binding Pic.Career}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="nav" Content="{v:Tr 'Operations'}" Command="{Binding GoBoard}" />
                    <Button Classes="nav" Content="{v:Tr 'New trip'}" Command="{Binding GoPlan}" />
                    <Button Classes="nav" Content="{v:Tr 'Map'}" Command="{Binding GoMap}" />
                    <Button Classes="nav" Content="{v:Tr 'People'}" Command="{Binding GoPeople}" />
                    <Button Classes="nav" Content="{v:Tr 'Logbook'}" Command="{Binding GoLogbook}" />
                    <Button Classes="nav" Content="{v:Tr 'Money'}" Command="{Binding GoMoney}" />
                    <Button Classes="nav" Content="{v:Tr 'Settings'}" Command="{Binding GoSettings}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Signal}" Padding="20,8" IsVisible="{Binding Pic.NeedKeys, FallbackValue=False}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Foreground="{StaticResource SignalInk}" VerticalAlignment="Center"
                           Text="{v:Tr 'The phone stays quiet until your Claude and ElevenLabs keys are in Settings.'}" />
                <Button Grid.Column="1" Content="{v:Tr 'Open Settings'}" Command="{Binding GoSettings}" Background="{StaticResource SignalInk}" Foreground="{StaticResource Signal}" />
            </Grid>
        </Border>

        <!-- Operations -->
        <Grid Grid.Row="2" ColumnDefinitions="340,*,360" IsVisible="{Binding OnBoard}">

            <!-- The phone -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="18">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="title" Text="{Binding Pic.PhoneTitle}" />
                        <TextBlock Classes="quiet" Text="{Binding Pic.PhoneSub}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,10">
                        <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding Pic.IsRinging, FallbackValue=False}">
                            <Button Classes="go" Content="{v:Tr 'Answer'}" Command="{Binding Answer}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{v:Tr 'Decline'}" Command="{Binding Decline}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </Grid>
                        <Button Content="{Binding Pic.HangUpLabel}" Command="{Binding HangUp}" IsVisible="{Binding Pic.IsTalking, FallbackValue=False}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding Pic.IsIdle, FallbackValue=False}">
                            <Button Content="{v:Tr 'Look for work'}" Command="{Binding RequestJob}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{Binding Pic.MicTestLabel}" Command="{Binding TestMic}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" x:Name="ChatScroll">
                        <ItemsControl ItemsSource="{Binding Pic.Chat}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatRow">
                                    <StackPanel Margin="0,0,0,10" Spacing="1">
                                        <TextBlock Classes="quiet" FontSize="12" Text="{Binding Who}" Foreground="{Binding WhoBrush}" />
                                        <TextBlock Text="{Binding Text}" LineHeight="20" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Classes="quiet" FontStyle="Italic" Margin="0,8,0,0" Text="{Binding Pic.Partial}" IsVisible="{Binding Pic.HasPartial, FallbackValue=False}" />

                    <StackPanel Grid.Row="4" Spacing="6" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <TextBlock Classes="quiet" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Text="{v:Tr 'Their voice'}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding VoiceVolume}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <TextBlock Classes="quiet" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Text="{v:Tr 'Their speed'}" />
                            <Slider Grid.Column="1" Minimum="70" Maximum="120" Value="{Binding VoiceSpeed}" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding MicLevel}" Height="3" MinWidth="0" />
                        <ItemsControl ItemsSource="{Binding Pic.Statuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusRow">
                                    <Grid ColumnDefinitions="14,62,*" Margin="0,1">
                                        <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Classes="quiet" FontSize="12" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Classes="quiet" FontSize="12" Text="{Binding Text}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The load sheet: the middle of the screen, because this is where the arguments are won -->
            <ScrollViewer Grid.Column="1" Padding="22,16">
                <Panel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="0,120,0,0" MaxWidth="420" IsVisible="{Binding Pic.NoCard, FallbackValue=True}">
                        <TextBlock Classes="big" Text="{v:Tr 'No flights on the sheet'}" TextAlignment="Center" />
                        <TextBlock Classes="quiet" TextAlignment="Center" Text="{v:Tr 'When someone calls and you agree on a flight, the weight, balance and fuel build up here as you talk.'}" />
                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding Pic.Card, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="title" Text="{Binding Pic.Card.Title}" />
                                <TextBlock Classes="big" Text="{Binding Pic.Card.Route}" FontWeight="Normal" />
                                <TextBlock Classes="quiet" Text="{Binding Pic.Card.DistanceLine}" />
                                <TextBlock Foreground="{StaticResource Signal}" Text="{Binding Pic.Card.MeetLine}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                <TextBlock Classes="big" TextAlignment="Right" Text="{Binding Pic.Card.When}" />
                                <TextBlock TextAlignment="Right" Text="{Binding Pic.Card.Price}" />
                                <TextBlock Classes="quiet" TextAlignment="Right" Text="{Binding Pic.Card.Phase}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding Pic.Card.CanMoveTime, FallbackValue=False}">
                            <TextBlock Foreground="{StaticResource Signal}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding WhenSoon}" />
                            <Button Classes="go" Content="{v:Tr 'Fly now'}" Command="{Binding MoveTime}" CommandParameter="now" />
                            <Button Content="-30 min" Command="{Binding MoveTime}" CommandParameter="-30" />
                            <Button Content="+30 min" Command="{Binding MoveTime}" CommandParameter="30" />
                            <Button Content="{v:Tr '+1 hour'}" Command="{Binding MoveTime}" CommandParameter="60" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,20,300">
                            <v:EnvelopeChart Data="{Binding Pic.Card.Envelope}" Height="330" />
                            <StackPanel Grid.Column="2" Spacing="12">
                                <StackPanel Spacing="1">
                                    <TextBlock Classes="big" Text="{Binding Pic.Card.Room}" Foreground="{Binding Pic.Card.RoomBrush}" />
                                    <TextBlock Classes="quiet" Text="{Binding Pic.Card.TakeoffWeight}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Pic.Card.Seats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SeatRow">
                                            <Grid ColumnDefinitions="90,*,Auto" Margin="0,3">
                                                <TextBlock Classes="quiet" FontSize="12" Text="{Binding Label}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Who}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Grid.Column="2" Text="{Binding Kg}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="quiet" Text="{Binding Pic.Card.FuelLine}" />
                                    <v:MarkBar Height="8" Value="{Binding Pic.Card.FuelFraction}" Mark="{Binding Pic.Card.FuelRequiredFraction}" Bar="{StaticResource Okay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Pic.Card.Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FindingRow">
                                    <TextBlock Classes="big" Margin="0,1" Text="{Binding Text}" Foreground="{Binding Brush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="go" Content="{Binding Pic.Card.BoardLabel}" Command="{Binding Board}" IsVisible="{Binding Pic.Card.CanBoard, FallbackValue=False}" />
                            <Button Content="{v:Tr 'Weigh the bags'}" Command="{Binding Weigh}" IsVisible="{Binding Pic.Card.CanWeigh, FallbackValue=False}" />
                            <Button Content="{v:Tr 'Leave 10 kg behind'}" Command="{Binding LeaveTen}" IsVisible="{Binding Pic.Card.CanBoard, FallbackValue=False}" />
                            <Button Content="{v:Tr 'Talk to them'}" Command="{Binding Meet}" IsVisible="{Binding Pic.Card.CanMeet, FallbackValue=False}" />
                            <Button Classes="go" Content="{v:Tr 'Settle up and say goodbye'}" Command="{Binding Deplane}" IsVisible="{Binding Pic.Card.CanDeplane, FallbackValue=False}" />
                            <Button Content="{v:Tr 'Call them'}" Command="{Binding CallCustomer}" CommandParameter="{Binding Pic.Card.Id}" IsVisible="{Binding Pic.Card.CanCall, FallbackValue=False}" />
                            <Panel IsVisible="{Binding Pic.Card.CanCancel, FallbackValue=False}">
                                <Button Content="{v:Tr 'Cancel this flight'}" Command="{Binding AskCancel}" IsVisible="{Binding NotAskingToCancel}" />
                            </Panel>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding AskingToCancel}">
                            <TextBlock Foreground="{StaticResource Danger}" Text="{v:Tr 'Cancel this flight? They will not be happy, and the later you do it the worse it gets.'}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{v:Tr 'Yes, cancel it'}" Command="{Binding ConfirmCancel}" CommandParameter="{Binding Pic.Card.Id}" Background="{StaticResource Danger}" Foreground="{StaticResource SignalInk}" />
                                <Button Content="{v:Tr 'Keep the flight'}" Command="{Binding KeepFlight}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="3" IsVisible="{Binding Pic.Card.HasReview, FallbackValue=False}">
                            <TextBlock Classes="big" Text="{Binding Pic.Card.ReviewLine}" />
                            <TextBlock Classes="quiet" Text="{Binding Pic.Card.ReviewPoints}" />
                            <TextBlock FontStyle="Italic" Text="{Binding Pic.Card.ReviewQuote}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,20,*">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="head" Text="{v:Tr 'Weather'}" />
                                <TextBlock Text="{Binding Pic.Card.Weather}" />
                                <TextBlock Classes="quiet" Text="{Binding Pic.Card.StripLine}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Classes="head" Text="{v:Tr 'Just changed'}" IsVisible="{Binding Pic.Card.HasChanges, FallbackValue=False}" />
                                <ItemsControl ItemsSource="{Binding Pic.Card.Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChangeRow">
                                            <TextBlock Foreground="{StaticResource Signal}" Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="quiet" Text="{Binding Pic.Card.Notes}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Panel>
            </ScrollViewer>

            <!-- Where and when -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="300,*">
                    <Panel>
                        <v:TileMap Data="{Binding Pic.Map}" Plane="{Binding Plane}" ClipToBounds="True" />
                        <Border Background="#C0101F1E" VerticalAlignment="Bottom" Padding="10,6" IsVisible="{Binding HasNav}">
                            <TextBlock Foreground="{StaticResource Signal}" FontWeight="SemiBold" Text="{Binding NavLine}" />
                        </Border>
                    </Panel>
                    <ScrollViewer Grid.Row="1" x:Name="RightScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                        <StackPanel Spacing="16" Margin="18,14,22,18">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="head" Text="{v:Tr 'This flight'}" />
                                <ItemsControl ItemsSource="{Binding Pic.Route}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RouteRow">
                                            <TextBlock Margin="0,1" Text="{Binding Text}" Foreground="{Binding Brush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="head" Text="{v:Tr 'Booked flights'}" />
                                <TextBlock Classes="quiet" Text="{v:Tr 'Nothing booked. Stay near the phone.'}" IsVisible="{Binding Pic.NoJobs, FallbackValue=False}" />
                                <ItemsControl ItemsSource="{Binding Pic.Jobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:JobRow">
                                            <Button Classes="row" BorderBrush="{StaticResource Line}"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectJob}" CommandParameter="{Binding Id}">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Classes="quiet" Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
                                                    <TextBlock Grid.Row="1" Classes="quiet" Text="{Binding Route}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="quiet" Text="{Binding When}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Classes="head" Text="{v:Tr 'Fuel'}" />
                                <TextBlock Classes="big" Text="{Binding Pic.Fuel.OnBoard}" />
                                <TextBlock Text="{Binding Pic.Fuel.Need}" />
                                <TextBlock Classes="quiet" Text="{Binding Pic.Fuel.Here}" />
                                <TextBlock Foreground="{StaticResource Signal}" Text="{Binding Pic.Fuel.Warning}" IsVisible="{Binding Pic.Fuel.HasWarning, FallbackValue=False}" />
                                <Button Classes="go" Content="{Binding Pic.Fuel.OneWayLabel}" Command="{Binding RefuelOneWay}" IsEnabled="{Binding Pic.Fuel.CanFuel, FallbackValue=False}" IsVisible="{Binding Pic.Fuel.HasOneWay, FallbackValue=False}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Classes="go" Content="{Binding Pic.Fuel.RoundTripLabel}" Command="{Binding RefuelRoundTrip}" IsEnabled="{Binding Pic.Fuel.CanFuel, FallbackValue=False}" IsVisible="{Binding Pic.Fuel.HasRoundTrip, FallbackValue=False}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Content="{Binding Pic.Fuel.FullLabel}" Command="{Binding RefuelFull}" IsEnabled="{Binding Pic.Fuel.CanFuel, FallbackValue=False}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <TextBlock Classes="quiet" Text="{Binding Pic.FuelCache}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="head" Text="{v:Tr 'Messages'}" />
                                <ItemsControl ItemsSource="{Binding Pic.Inbox}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SmsRow">
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Classes="quiet" FontSize="12">
                                                    <Run Text="{Binding From}" />
                                                    <Run Text="{Binding When}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- A trip you choose yourself -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding OnPlan}" Padding="32,20">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel Spacing="2">
                    <TextBlock Classes="title" Text="{v:Tr 'New trip'}" />
                    <TextBlock Classes="quiet" Text="{v:Tr 'Choose who calls, what it is about and where it goes. You still agree on people, bags and price on the phone.'}" />
                </StackPanel>
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                    <TextBlock Classes="quiet" VerticalAlignment="Center" Text="{v:Tr 'Who'}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding PlanPeople}" SelectedItem="{Binding SelectedPlanPerson}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlanPerson"><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Classes="quiet" VerticalAlignment="Center" Text="{v:Tr 'What'}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding PlanJobLabels}" SelectedIndex="{Binding PlanJobIndex}" />
                    <TextBlock Grid.Row="2" Classes="quiet" VerticalAlignment="Center" Text="{v:Tr 'From'}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding PlanPlaceLabels}" SelectedIndex="{Binding PlanFromIndex}" />
                    <TextBlock Grid.Row="3" Classes="quiet" VerticalAlignment="Center" Text="{v:Tr 'To'}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding PlanPlaceLabels}" SelectedIndex="{Binding PlanToIndex}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="go" Content="{v:Tr 'Make the phone ring'}" Command="{Binding PlanCall}" />
                    <Button Content="{v:Tr 'Make a code for a friend'}" Command="{Binding PlanMakeCode}" />
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding HasTripCode}">
                    <TextBlock Classes="head" Text="{v:Tr 'Send this to your friend. You both get the same trip, with the same people.'}" />
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" Text="{Binding TripCodeText}" />
                    <Button Content="{v:Tr 'Copy the code'}" Click="CopyTripCode" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Classes="head" Text="{v:Tr 'Got a code from a friend?'}" />
                    <TextBox TextWrapping="Wrap" MaxHeight="110" Watermark="FC1-..." Text="{Binding PastedCode}" />
                    <Button Content="{v:Tr 'Run this trip'}" Command="{Binding PlanRunPasted}" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The big map -->
        <Grid Grid.Row="2" ColumnDefinitions="*,330" IsVisible="{Binding OnMap}">
            <v:TileMap Data="{Binding Pic.Map}" Plane="{Binding Plane}" ClipToBounds="True" />
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Margin="18,16">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="head" Text="{v:Tr 'The aircraft now'}" />
                            <TextBlock Classes="big" Text="{Binding MapHeading}" />
                            <TextBlock Text="{Binding MapAlt}" />
                            <TextBlock Text="{Binding MapSpeed}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding HasNav}">
                            <TextBlock Classes="head" Text="{v:Tr 'Where to fly now'}" />
                            <TextBlock Classes="big" Foreground="{StaticResource Signal}" Text="{Binding NavLine}" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Classes="head" Text="{v:Tr 'This flight'}" />
                            <ItemsControl ItemsSource="{Binding Pic.Route}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RouteRow">
                                        <TextBlock Margin="0,1" Text="{Binding Text}" Foreground="{Binding Brush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="quiet" Text="{Binding Pic.Card.DistanceLine, FallbackValue=''}" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Classes="head" Text="{v:Tr 'Fuel'}" />
                            <TextBlock Text="{Binding Pic.Fuel.OnBoard}" />
                            <TextBlock Text="{Binding Pic.Fuel.Need}" />
                            <TextBlock Classes="quiet" Text="{Binding ReachLine}" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Classes="head" Text="{v:Tr 'Weather'}" />
                            <TextBlock Text="{Binding Pic.Card.Weather, FallbackValue=''}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="head" Text="{v:Tr 'On the map'}" />
                            <TextBlock Classes="quiet" FontSize="12" Text="{v:Tr 'Scroll to zoom and drag to move. Buttons: plus and minus zoom, F follows the aircraft, R shows the whole route again. Yellow is your route, white your next leg, green your track and how far the fuel reaches. Squares are airports. Zoom in for lakes, rivers and villages.'}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- People who remember you -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding OnPeople}" Padding="28,20">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="title" Text="{v:Tr 'People who remember you'}" />
                        <TextBlock Classes="quiet" Text="{Binding Pic.PeopleSummary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="{v:Tr 'Everyone'}" Command="{Binding FilterAll}" />
                        <Button Content="{v:Tr 'Friends'}" Command="{Binding FilterFriends}" />
                        <Button Content="{v:Tr 'Wary'}" Command="{Binding FilterWary}" />
                        <Button Content="{v:Tr 'Not flown yet'}" Command="{Binding FilterNotFlown}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{v:Tr 'Make everyone forget me'}" Command="{Binding AskForgetAll}" IsVisible="{Binding NotAskingForgetAll}" />
                    <TextBlock Foreground="{StaticResource Danger}" VerticalAlignment="Center" IsVisible="{Binding AskingForgetAll}" Text="{v:Tr 'Everyone forgets you: trust, memories and history. Your money and logbook stay.'}" />
                    <Button Content="{v:Tr 'Yes, wipe everyone'}" Command="{Binding ConfirmForgetAll}" IsVisible="{Binding AskingForgetAll}" Background="{StaticResource Danger}" Foreground="{StaticResource SignalInk}" />
                    <Button Content="{v:Tr 'No, keep them'}" Command="{Binding KeepPeople}" IsVisible="{Binding AskingForgetAll}" />
                </StackPanel>
                <TextBlock Classes="quiet" Text="{v:Tr 'Nobody yet. Everyone you talk to ends up here.'}" IsVisible="{Binding Pic.NoPeople, FallbackValue=False}" />
                <ItemsControl ItemsSource="{Binding PeopleShown}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PersonRow">
                            <Button Classes="person" Width="330" Margin="0,0,12,12" CommandParameter="{Binding Id}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenPerson}">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="Auto,12,*">
                                        <Border Width="44" Height="44" CornerRadius="22" Background="{Binding AvatarBrush}">
                                            <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="1">
                                            <TextBlock Classes="big" FontSize="17" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Classes="quiet" FontSize="12" Text="{Binding Line}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock FontSize="12" Text="{v:Tr 'Trust'}" Foreground="{StaticResource Lichen}" />
                                            <TextBlock Grid.Column="1" FontSize="12" Text="{Binding Standing}" Foreground="{Binding StandingBrush}" />
                                        </Grid>
                                        <v:MarkBar Height="6" Value="{Binding TrustValue}" Mark="0.5" Bar="{Binding StandingBrush}" />
                                    </StackPanel>
                                    <TextBlock Classes="quiet" FontSize="12" Text="{Binding QuickFacts}" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource Danger}" Text="{Binding SeriousLine}" IsVisible="{Binding HasSerious}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontStyle="Italic" FontSize="13" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{Binding Memory}" IsVisible="{Binding HasMemory}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Logbook -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding OnLogbook}" Padding="32,20">
            <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="title" Text="{v:Tr 'Logbook'}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="{v:Tr 'Flights'}" Command="{Binding LogFlights}" />
                        <Button Content="{v:Tr 'Conversations'}" Command="{Binding LogTalks}" />
                        <Button Content="{v:Tr 'Where you behaved badly'}" Command="{Binding LogOffences}" />
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Pic.LogStats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatRow">
                            <StackPanel Width="165" Margin="0,0,0,6">
                                <TextBlock Classes="big" FontSize="24" Text="{Binding Value}" />
                                <TextBlock Classes="quiet" FontSize="12" Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="0" IsVisible="{Binding OnLogFlights}">
                    <TextBlock Classes="quiet" Text="{v:Tr 'No finished flights yet.'}" IsVisible="{Binding Pic.NoFlights, FallbackValue=False}" />
                    <ItemsControl ItemsSource="{Binding Pic.Logbook}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogRow">
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid ColumnDefinitions="*,24,170">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="big" Text="{Binding Title}" />
                                            <TextBlock Classes="quiet" Text="{Binding When}" />
                                            <TextBlock Text="{Binding Route}" />
                                            <TextBlock FontStyle="Italic" Text="{Binding Quote}" Margin="0,4,0,0" />
                                            <ItemsControl ItemsSource="{Binding Points}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Classes="quiet" FontSize="12" Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock FontSize="20" Foreground="{StaticResource Signal}" TextAlignment="Right" Text="{Binding StarSigns}" />
                                            <TextBlock Classes="quiet" TextAlignment="Right" Text="{Binding Stars}" />
                                            <TextBlock Classes="big" TextAlignment="Right" Foreground="{Binding MoneyBrush}" Text="{Binding Money}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="0" IsVisible="{Binding OnLogTalks}">
                    <TextBlock Classes="quiet" Text="{v:Tr 'Every conversation ends up here, word for word.'}" IsVisible="{Binding Pic.NoTalks, FallbackValue=False}" />
                    <ItemsControl ItemsSource="{Binding TalksShown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TalkRow">
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel Spacing="6">
                                        <ToggleButton x:Name="Open" Classes="row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Classes="big" Text="{Binding Names}" />
                                                    <TextBlock Classes="quiet" Text="{Binding What}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock TextAlignment="Right" Text="{Binding When}" />
                                                    <TextBlock TextAlignment="Right" Foreground="{Binding FlagBrush}" Text="{Binding Flag}" IsVisible="{Binding HasFlag}" />
                                                    <TextBlock Classes="quiet" TextAlignment="Right" FontSize="12" Text="{Binding Count}" />
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>
                                        <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding #Open.IsChecked}" Margin="12,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TalkLine">
                                                    <Grid ColumnDefinitions="130,*" Margin="0,3">
                                                        <TextBlock FontSize="12" Foreground="{Binding Brush}" Text="{Binding Who}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Text}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Money -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding OnMoney}" Padding="32,20">
            <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Classes="title" Text="{v:Tr 'Money'}" />
                <ItemsControl ItemsSource="{Binding Pic.Ledger}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LedgerRow">
                            <Grid ColumnDefinitions="110,*,Auto" Margin="0,4">
                                <TextBlock Classes="quiet" Text="{Binding When}" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" />
                                <TextBlock Grid.Column="2" Text="{Binding Amount}" Foreground="{Binding AmountBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding OnSettings}" Padding="32,20">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Classes="title" Text="{v:Tr 'Settings'}" />
                <StackPanel Spacing="4">
                    <TextBlock Classes="head" Text="{v:Tr 'Claude API key'}" />
                    <TextBox PasswordChar="*" Text="{Binding AnthropicKey}" />
                    <TextBlock Classes="quiet" Text="{v:Tr 'Create it at platform.claude.com, in the organization linked to your plan\'s API credits. It is stored encrypted for your Windows user.'}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="head" Text="{v:Tr 'ElevenLabs API key'}" />
                    <TextBox PasswordChar="*" Text="{Binding ElevenLabsKey}" />
                    <Button Content="{v:Tr 'Get Norwegian voices'}" Command="{Binding AddVoices}" HorizontalAlignment="Left" />
                    <TextBlock Classes="quiet" Text="{v:Tr 'Adds real Norwegian voices to your ElevenLabs account, northern ones first. Needs a paid plan and uses no credits.'}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="head" Text="{v:Tr 'Language'}" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex}" MinWidth="240" />
                    <TextBlock Classes="quiet" Text="{v:Tr 'Restart the app to change the screen language.'}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="head" Text="{v:Tr 'Voice model'}" />
                    <ComboBox ItemsSource="{Binding VoiceModelLabels}" SelectedIndex="{Binding VoiceModelIndex}" MinWidth="320" />
                    <CheckBox IsChecked="{Binding RadioEffect}" Content="{v:Tr 'Phone and headset sound on calls'}" />
                    <TextBlock Classes="quiet" Text="{v:Tr 'Turn this off to hear a voice exactly as ElevenLabs makes it. Applies from the next call.'}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="head" Text="{v:Tr 'Speech recognition'}" />
                    <ComboBox ItemsSource="{Binding SpeechModelLabels}" SelectedIndex="{Binding SpeechModelIndex}" MinWidth="320" />
                    <TextBlock Classes="quiet" Text="{v:Tr 'Restart the app to change the speech model. A new one downloads on first use.'}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="head" Text="{v:Tr 'Model for the people you talk to'}" />
                    <ComboBox ItemsSource="{Binding SpeakerModels}" SelectedItem="{Binding SpeakerModel}" MinWidth="240" />
                    <TextBlock Classes="quiet" Text="{v:Tr 'Haiku replies fastest and costs least. Try Opus if people feel flat.'}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="head" Text="{v:Tr 'Your name'}" />
                        <TextBox Text="{Binding PilotName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="head" Text="{v:Tr 'Company name'}" />
                        <TextBox Text="{Binding CompanyName}" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Classes="head" Text="{v:Tr 'Your weight in kg'}" />
                    <NumericUpDown Value="{Binding PilotKg}" Minimum="40" Maximum="160" Increment="1" FormatString="0" MaxWidth="140" HorizontalAlignment="Left" />
                </StackPanel>
                <CheckBox IsChecked="{Binding UsingSpeakers}" Content="{v:Tr 'I play through speakers, not a headset'}" />
                <CheckBox IsChecked="{Binding DoNotDisturb}" Content="{v:Tr 'Do not disturb: no new calls'}" />
                <TextBlock Classes="quiet" Text="{v:Tr 'Scroll Lock mutes your mic from anywhere, so you can talk on Discord or to ATC without the passengers answering.'}" />
                <Button Classes="go" Content="{v:Tr 'Save settings'}" Command="{Binding SaveSettings}" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>

        <!-- The line along the bottom: what the aircraft is doing right now -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,7">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="quiet" Text="{Binding LiveLine}" />
                <TextBlock Grid.Column="1" Foreground="{StaticResource Signal}" Text="{Binding Toast}" IsVisible="{Binding HasToast}" />
            </Grid>
        </Border>

        <!-- One person, everything known about them -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#B0081211" IsVisible="{Binding HasSelectedPerson}">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"
                    Width="720" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="Auto,16,*">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{Binding SelectedPerson.AvatarBrush, FallbackValue={x:Null}}">
                            <TextBlock Text="{Binding SelectedPerson.Initials, FallbackValue=''}" FontWeight="SemiBold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="title" Text="{Binding SelectedPerson.Name, FallbackValue=''}" />
                            <TextBlock Classes="quiet" Text="{Binding SelectedPerson.Line, FallbackValue=''}" />
                            <TextBlock Text="{Binding SelectedPerson.Standing, FallbackValue=''}" Foreground="{Binding SelectedPerson.StandingBrush, FallbackValue={x:Null}}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,16">
                        <StackPanel Spacing="18" Margin="0,0,14,0">
                            <TextBlock Text="{Binding SelectedPerson.Personality, FallbackValue=''}" />

                            <ItemsControl ItemsSource="{Binding SelectedPerson.Bars, FallbackValue={x:Null}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BarRow">
                                        <Grid ColumnDefinitions="110,*,170" Margin="0,4">
                                            <TextBlock Classes="quiet" VerticalAlignment="Center" Text="{Binding Label}" />
                                            <v:MarkBar Grid.Column="1" Height="8" VerticalAlignment="Center" Value="{Binding Value}" Bar="{Binding Brush}" />
                                            <TextBlock Grid.Column="2" Classes="quiet" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Text}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding SelectedPerson.Facts, FallbackValue={x:Null}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FactRow">
                                        <StackPanel Width="215" Margin="0,0,0,10" Spacing="0">
                                            <TextBlock Classes="quiet" FontSize="12" Text="{Binding Label}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Value}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="head" Text="{v:Tr 'What has happened between you'}" />
                                <TextBlock Classes="quiet" Text="{v:Tr 'Nothing yet.'}" IsVisible="{Binding SelectedPerson.NoRecord, FallbackValue=False}" />
                                <ItemsControl ItemsSource="{Binding SelectedPerson.Record, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecordRow">
                                            <Grid ColumnDefinitions="100,*,50" Margin="0,3">
                                                <TextBlock Classes="quiet" FontSize="12" Text="{Binding When}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" />
                                                <TextBlock Grid.Column="2" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding Change}" Foreground="{Binding ChangeBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="head" Text="{v:Tr 'What they remember'}" />
                                <TextBlock Classes="quiet" Text="{v:Tr 'Nothing yet.'}" IsVisible="{Binding SelectedPerson.NoMemories, FallbackValue=False}" />
                                <ItemsControl ItemsSource="{Binding SelectedPerson.Memories, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MemoryRow">
                                            <Grid ColumnDefinitions="90,*" Margin="0,3">
                                                <TextBlock Classes="quiet" FontSize="12" Text="{Binding When}" />
                                                <TextBlock Grid.Column="1" FontStyle="Italic" Text="{Binding Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="head" Text="{v:Tr 'Flights together'}" />
                                <TextBlock Classes="quiet" Text="{v:Tr 'No flights yet.'}" IsVisible="{Binding SelectedPerson.NoFlights, FallbackValue=False}" />
                                <ItemsControl ItemsSource="{Binding SelectedPerson.Flights, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PersonFlightRow">
                                            <Grid ColumnDefinitions="70,*,120,90" Margin="0,3">
                                                <TextBlock Classes="quiet" FontSize="12" Text="{Binding When}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" />
                                                    <TextBlock Classes="quiet" FontSize="12" Text="{Binding Route}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Classes="quiet" Text="{Binding Outcome}" />
                                                <TextBlock Grid.Column="3" TextAlignment="Right" Text="{Binding Money}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding NotAskingForget}">
                        <Button Content="{v:Tr 'Delete'}" Command="{Binding AskDeletePerson}" />
                        <Button Content="{v:Tr 'Make them forget me'}" Command="{Binding AskResetPerson}" />
                        <Button Classes="go" Content="{Binding SelectedPerson.CallLabel, FallbackValue=''}" Command="{Binding CallPerson}" CommandParameter="{Binding SelectedPerson.Id, FallbackValue=''}" />
                        <Button Content="{v:Tr 'Close'}" Command="{Binding ClosePerson}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding AskingForget}">
                        <TextBlock Foreground="{StaticResource Danger}" Text="{Binding AskForgetText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="{v:Tr 'Yes, do it'}" Command="{Binding ConfirmForget}" Background="{StaticResource Danger}" Foreground="{StaticResource SignalInk}" />
                            <Button Content="{v:Tr 'No, keep them'}" Command="{Binding KeepPeople}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
